# Jal Mitra (ಜಲ ಮಿತ್ರ) - Environment Configuration
# Copy this file to .env and adjust variables as required

# Application Details
VITE_APP_NAME="Jal Mitra"
VITE_APP_TITLE_EN="Jal Mitra - Village Water Quality & Grievance Reporting"
VITE_APP_TITLE_KN="ಜಲ ಮಿತ್ರ - ಗ್ರಾಮ/ವಾರ್ಡ್ ಕುಡಿಯುವ ನೀರು ಗುಣಮಟ್ಟ ದೂರು ನಿರ್ವಹಣೆ"
VITE_DEFAULT_LANG="en" # Options: "en" | "kn"

# Hotspot Detection Rule Configuration
# Triggers high-priority cluster alert when reports >= threshold within window days for the same ward
VITE_HOTSPOT_THRESHOLD=3
VITE_HOTSPOT_WINDOW_DAYS=7

# Default Map View Coordinates (Defaults to Karnataka regional coordinates)
VITE_MAP_DEFAULT_LAT=12.9716
VITE_MAP_DEFAULT_LNG=77.5946
VITE_MAP_DEFAULT_ZOOM=13

# Offline / Local Storage Key Prefix
VITE_STORAGE_PREFIX="jal_mitra_"

# Server Port (if running dev server)
PORT=5173
